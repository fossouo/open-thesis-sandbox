# Copy to .env and adjust for your setup:
#   cp .env.example .env
#   then edit .env with your real values.
#
# IMPORTANT: LITELLM_URL must NOT point to localhost:8000 — that is the app's
# own port. Setting it there creates a self-loop (the app calls itself).
# The startup guard will detect this and exit with a clear error.

# LiteLLM gateway — point this at your inference proxy.
# Works with: OpenAI, vLLM, llama.cpp, LiteLLM, LM Studio, ...
# Replace with your actual host (e.g. http://your-actual-host:4000/v1/chat/completions)
# NEVER set to localhost:8000 (the app's own port) — causes a self-loop.
LITELLM_URL=http://your-litellm-host:4000/v1/chat/completions
LITELLM_MODEL=gpt-4o-mini
# Bearer token sent only if non-empty. Replace with your actual key.
LITELLM_API_KEY=sk-replace-with-your-key

# Optional: OpenAI-compatible TTS endpoint for the audio-overview feature.
TTS_API_URL=http://your-tts-host:8880/v1/audio/speech
TTS_MODEL=kokoro

# Where rendered audio overviews are cached.
AUDIO_CACHE_DIR=./data/audio-cache
