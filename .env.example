# Copy to .env and adjust for your setup.

# OpenAI-compatible Chat Completions endpoint.
# Works with: OpenAI, Ollama, vLLM, llama.cpp, LiteLLM, LM Studio, ...
LITELLM_URL=http://localhost:8000/v1/chat/completions
LITELLM_MODEL=gpt-4o-mini
# Leave empty if your endpoint does not require auth (local servers usually don't).
LITELLM_API_KEY=

# Optional: OpenAI-compatible TTS endpoint for the audio-overview feature.
TTS_API_URL=http://localhost:8880/v1/audio/speech
TTS_MODEL=kokoro

# Where rendered audio overviews are cached.
AUDIO_CACHE_DIR=./data/audio-cache
